llm:
  # 模型提供方，当前示例仅演示 openai 兼容接口
  provider: openai
  model: gpt-4o-mini
  base_url: ""
  api_key: ""
  temperature: 0.0
  timeout: 60
  max_retries: 2

embedding:
  provider: openai
  model: text-embedding-3-small
  base_url: ""
  api_key: ""

offline:
  enabled: true
  fallback_model: offline-agent