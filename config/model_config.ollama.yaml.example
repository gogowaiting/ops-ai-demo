llm:
  # 使用本机 Ollama 的 OpenAI 兼容接口
  provider: ollama
  model: qwen3:8b
  base_url: "http://localhost:11434/v1"
  api_key: "ollama"
  temperature: 0.0
  timeout: 120
  max_retries: 2

embedding:
  # 模型必须支持 Ollama embeddings API
  provider: ollama
  model: bge-m3
  base_url: "http://localhost:11434/v1"
  api_key: "ollama"

offline:
  enabled: true
  fallback_model: offline-agent
