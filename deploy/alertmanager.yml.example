route:
  receiver: ops-ai
  group_by: [alertname, service]
  group_wait: 10s
  group_interval: 30s
  repeat_interval: 2h

receivers:
  - name: ops-ai
    webhook_configs:
      - url: http://ops-ai:8765/api/alerts
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: "<ALERT_WEBHOOK_TOKEN>"
