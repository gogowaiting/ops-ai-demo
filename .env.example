# 1. 必填：部署身份与数据源模式
OPS_ENVIRONMENT=production
OPS_TOOLS_MODE=real
OPS_DB_BACKEND=sqlite
# OPS_DB_URL=postgresql+psycopg://ops_ai:password@postgres:5432/ops_ai
OPS_WEB_AUTH_MODE=token

# 2. 必填：外部数据源与 Web Token
PROMETHEUS_URL=https://prometheus.example.com
LOKI_URL=https://loki.example.com
# K8S_CONTEXT 留空时，集群内部署使用 ServiceAccount
K8S_CONTEXT=production
K8S_NAMESPACE=default
WEB_PORT=8765
OPS_WEB_API_TOKEN=
OPS_WEB_API_USER=ops-operator

# 3. 模型：OpenAI 与 Ollama 二选一
# LLM_PROVIDER=openai
# EMBED_PROVIDER=openai
# OPENAI_API_KEY=
# EMBED_API_KEY=

LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3

# 4. 推荐但可省略
ALERT_WEBHOOK_TOKEN=
OPS_WEB_CORS=0

# 5. 高级默认值，通常无需修改
OPS_WEB_HOST=0.0.0.0
OPS_WEB_PORT=8765
OPS_WEB_API_ROLES=operator
OPS_WEB_IDENTITY_HEADER=X-User
OPS_WEB_ROLES_HEADER=X-Roles
CHECKPOINT_DB=/app/data/checkpoints.sqlite
APPROVAL_AUDIT_DB=/app/data/approvals.sqlite
ALERT_JOB_DB=/app/data/alert_jobs.sqlite
DIAGNOSTIC_TRACE_DB=/app/data/traces.sqlite
